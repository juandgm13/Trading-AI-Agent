# ── GNews ─────────────────────────────────────────────────────────────────────
GNEWS_API_KEY=your_gnews_api_key_here

# ── Gmail SMTP (alertas de email) ─────────────────────────────────────────────
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
# Destinatario de las alertas (si no se define, se usa GMAIL_USER)
ALERT_RECIPIENT=your_email@gmail.com

# ── Alpaca Trading API ─────────────────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Paper trading (por defecto). Para live: https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Watchlist ──────────────────────────────────────────────────────────────────
# Símbolos separados por comas. Si no se define, se usan TODOS los activos
# negociables de Alpaca (US equities activos).
# WATCHLIST_SYMBOLS=AAPL,MSFT,NVDA,GOOGL,AMZN

# ── Ollama ────────────────────────────────────────────────────────────────────
# URL del servidor Ollama (por defecto: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# ── Trading ────────────────────────────────────────────────────────────────────
# Valor máximo en USD por posición abierta (por defecto: 500)
# MAX_POSITION_VALUE=500

# ── Logging ───────────────────────────────────────────────────────────────────
# Nivel de log: DEBUG | INFO | WARNING | ERROR (por defecto: INFO)
# LOG_LEVEL=INFO
